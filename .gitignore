.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# =============================================================================
# Node / frontend
# =============================================================================
node_modules/
dist/
.vite/
*.local
npm-debug.log*
yarn-error.log*

# =============================================================================
# Data — downloaded, not authored
# =============================================================================
# The Kaggle dataset (~51MB) and everything model/refresh.py pulls from
# football-data.co.uk and ClubElo. All of it is reproducible:
#
#   curl -L -o model/data/raw.zip \
#     "https://www.kaggle.com/api/v1/datasets/download/adamgbor/club-football-match-data-2000-2025"
#   unzip -o model/data/raw.zip -d model/data && rm model/data/raw.zip
#
# See the README for the full setup steps.
model/data/*.csv
model/data/*.zip
model/data/live/

# Keep the directory itself, so the download above has somewhere to land.
!model/data/.gitkeep

# =============================================================================
# Trained artefacts
# =============================================================================
# These ARE committed, deliberately. Together they are only ~4.8MB, and they
# are everything the API needs to serve:
#
#   model.pkl       the trained forest (3.6MB)
#   state.pkl       team state from training - refresh.py rebuilds from this
#   state_live.pkl  refreshed state, what the API actually reads
#   metrics.json    evaluation results, for the Model Info page
#   backtest.csv    out-of-sample predictions, for the Track record page
#
# Committing them means a deploy needs NO build step and NO 42MB dataset
# download -- which is what makes the free tier viable. The 42MB Matches.csv
# stays ignored because only train.py reads it.
!model/model.pkl
!model/state.pkl
!model/state_live.pkl
!model/metrics.json
!model/data/backtest.csv
# Of everything refresh.py downloads into live/, only fixtures.csv is read at
# runtime. clubelo.csv and new_results.csv are intermediates -- keep them out.
!model/data/live/
model/data/live/*
!model/data/live/fixtures.csv

